; Šablona GameForge: startovní 2D projekt pro Godot 4.7.
; Hra se skládá programově ze skriptu (scripts/game.gd) – díky tomu se dá celá
; generovat a upravovat textem, bez klikání v editoru.

config_version=5

[application]

config/name="demo1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="mobile"
; 0 = Nearest – u pixel-artu žádoucí (ostré hrany, žádné rozmazání)
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.09, 0.11, 0.16, 1)

[physics]

common/physics_ticks_per_second=60
