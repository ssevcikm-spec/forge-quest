# Godot
.godot/
*.translation
export_presets.cfg.bak

# Buildy a artefakty (v CI se generují znovu)
build/
artifacts/
assets/_raw/

# Python cache (vzniká při kontrole syntaxe)
__pycache__/
*.pyc

# Lokální nástroje
.forge/provider.json
# Volba poskytovatele pro shell v témže kroku (druhý pokus agenta). Kdyby se
# dostala do repa, `git add -A` by ji poslal do PR a běh bez změny kódu by se
# hlásil jako úspěch.
.forge/provider.env
.forge/*.log
agent.patch
agent.log
# Log z kontrolního spuštění hry. Workflow ho sice píše do RUNNER_TEMP,
# ale kdyby ho někdo zapsal sem, `git add -A` by ho poslal do patche –
# přesně tak se dostal do PR #10.
smoke.log
.aider*
# Pojistka: cokoli, co vypada jako rozbita cesta k secretu
/C:*Users*
UsersSsevc*
.secrets/
git-credentials
